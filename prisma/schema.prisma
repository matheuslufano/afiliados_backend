generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  city      String?
  photoUrl  String?
  role      String   @default("USER")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  teamId Int?
  team   CrmTeam? @relation(fields: [teamId], references: [id], onDelete: SetNull)

  links Link[]
  createdCrmDeals     CrmDeal[]        @relation("CrmDealCreatedBy")
  responsibleCrmDeals CrmDeal[]        @relation("CrmDealResponsible")
  updatedCrmDeals     CrmDeal[]        @relation("CrmDealUpdatedBy")
  savedCrmFilters     SavedCrmFilter[]

  @@index([teamId, active])
}

model CrmTeam {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
}

model Affiliate {
  id        Int      @id @default(autoincrement())
  name      String
  email     String?  @unique
  phone     String?
  city      String?
  photoUrl  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  links Link[]
  crmDeals CrmDeal[]
  affiliateCommissions AffiliateCommission[]
} 

model Campaign {
  id             Int      @id @default(autoincrement())
  name           String
  destinationUrl String
  createdAt      DateTime @default(now())

  links Link[]
}

model Link {
  id           Int      @id @default(autoincrement())
  name         String?
  originalUrl  String
  shortCode    String   @unique
  affiliateUrl String?
  createdAt    DateTime @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id])

  affiliateId Int?
  affiliate Affiliate? @relation(fields: [affiliateId], references: [id])

  campaignId Int?
  campaign Campaign? @relation(fields: [campaignId], references: [id])

  clicks Click[]
  conversions Conversion[]
  crmDeals CrmDeal[]
}

model Click {
  id              Int      @id @default(autoincrement())
  ipAddress       String?
  userAgent       String?
  referrer        String?
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  utmTerm         String?
  utmContent      String?
  source          String?
  deviceType      String?
  browser         String?
  operatingSystem String?
  platform        String?
  language        String?
  geoCountry      String?
  geoRegion       String?
  geoCity         String?
  timezone        String?
  screenWidth     Int?
  screenHeight    Int?
  clickedAt       DateTime @default(now())

  linkId Int
  link   Link @relation(fields: [linkId], references: [id])
}

model Conversion {
  id              Int      @id @default(autoincrement())
  type            String   @default("whatsapp")
  product         String?
  destination     String?
  visitorName     String?
  visitorPhone    String?
  visitorDocument String?
  visitorCity     String?
  source          String?
  ipAddress       String?
  userAgent       String?
  referrer        String?
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  utmTerm         String?
  utmContent      String?
  deviceType      String?
  browser         String?
  operatingSystem String?
  platform        String?
  language        String?
  geoCountry      String?
  geoRegion       String?
  geoCity         String?
  timezone        String?
  screenWidth     Int?
  screenHeight    Int?
  convertedAt     DateTime @default(now())

  linkId Int
  link   Link @relation(fields: [linkId], references: [id])

  crmDeal CrmDeal?
}

model WebhookLog {
  id              Int      @id @default(autoincrement())
  provider        String
  attendanceId    String?
  channelName     String?
  channelType     String?
  eventStatus     String?
  shortCode       String?
  conversionId    Int?
  linkId          Int?
  visitorName     String?
  visitorPhone    String?
  visitorDocument String?
  ipAddress       String?
  userAgent       String?
  raw             Json
  query           Json
  result          Json
  receivedAt      DateTime @default(now())

  @@index([provider, receivedAt])
  @@index([attendanceId])
  @@index([shortCode])
}

model CrmFunnel {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stages CrmStage[]
  deals  CrmDeal[]
}

model CrmStage {
  id          Int      @id @default(autoincrement())
  name        String
  position    Int
  color       String?
  slaHours    Int?
  isFinal     Boolean  @default(false)
  isWonStage  Boolean  @default(false)
  isLostStage Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  funnelId Int
  funnel   CrmFunnel @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  deals    CrmDeal[]

  @@unique([funnelId, name])
  @@index([funnelId, position])
}

model CrmDealStatus {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  name      String
  color     String?
  isFinal   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deals CrmDeal[]
}

model CrmLeadSource {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  type      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deals CrmDeal[]
}

model CrmDeal {
  id                Int       @id @default(autoincrement())
  customerName      String
  phone             String?
  email             String?
  city              String?
  neighborhood      String?
  address           String?
  estimatedValue    Decimal?  @db.Decimal(10, 2)
  monthlyValue      Decimal?  @db.Decimal(10, 2)
  plan              String?
  priorityLevel     String    @default("medium")
  cardColor         String?
  owner             String?
  notes             String?
  trackingCode      String?
  rdId              String?
  chatmixId         String?
  sgpId             String?
  campaignName      String?
  lastInteractionAt DateTime?
  nextFollowUpAt    DateTime?
  closedAt          DateTime?
  archivedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  funnelId     Int
  funnel       CrmFunnel @relation(fields: [funnelId], references: [id])
  stageId      Int
  stage        CrmStage @relation(fields: [stageId], references: [id])
  statusId     Int
  status       CrmDealStatus @relation(fields: [statusId], references: [id])
  sourceId     Int?
  source       CrmLeadSource? @relation(fields: [sourceId], references: [id])
  affiliateId  Int?
  affiliate    Affiliate? @relation(fields: [affiliateId], references: [id])
  linkId       Int?
  link         Link? @relation(fields: [linkId], references: [id])
  conversionId Int? @unique
  conversion   Conversion? @relation(fields: [conversionId], references: [id])
  createdByUserId Int?
  createdByUser   User? @relation("CrmDealCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  responsibleUserId Int?
  responsibleUser   User? @relation("CrmDealResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  updatedByUserId Int?
  updatedByUser   User? @relation("CrmDealUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  tasks       CrmDealTask[]
  history     CrmDealHistory[]
  commissions AffiliateCommission[]

  @@index([funnelId])
  @@index([stageId])
  @@index([statusId])
  @@index([affiliateId])
  @@index([createdAt])
  @@index([createdByUserId])
  @@index([responsibleUserId])
}

model SavedCrmFilter {
  id         Int      @id @default(autoincrement())
  name       String
  funnelId   Int?
  conditions Json
  sort       Json?
  visibility String   @default("PRIVATE")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  ownerUserId Int
  owner       User @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([ownerUserId, isDefault])
  @@index([visibility])
}

model CrmDealTask {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  taskType    String?
  status      String    @default("pending")
  dueAt       DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  dealId Int
  deal   CrmDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId, status])
}

model CrmDealHistory {
  id        Int      @id @default(autoincrement())
  eventType String
  message   String
  metadata  Json?
  createdAt DateTime @default(now())

  dealId Int
  deal   CrmDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId, createdAt])
}

model CrmSyncLog {
  id              Int       @id @default(autoincrement())
  integrationName String
  status          String
  message         String?
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  createdAt       DateTime  @default(now())
}

model AffiliateCommission {
  id        Int      @id @default(autoincrement())
  amount    Decimal  @db.Decimal(10, 2)
  status    String   @default("pending")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  affiliateId Int
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id])
  dealId      Int
  deal        CrmDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@unique([affiliateId, dealId])
  @@index([dealId])
}
